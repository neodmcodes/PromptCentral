{
  "name": "promptcentral",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A tiny personal prompt library with fill-in variables.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,gray \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p server/tsconfig.json && tsc --noEmit -p tsconfig.json && vite build",
    "start": "node --disable-warning=ExperimentalWarning dist-server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
